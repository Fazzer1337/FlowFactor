<Window x:Class="FlowFactor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="FlowFactor калькулятор"
        Height="700"
        Width="1100"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg}"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <SolidColorBrush x:Key="AppBg" Color="#141414"/>
        <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#3A3A3A"/>

        <SolidColorBrush x:Key="AppFg" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="MutedFg" Color="#BEBEBE"/>

        <SolidColorBrush x:Key="GraphBg" Color="#101010"/>
        <SolidColorBrush x:Key="NodeBg" Color="#252525"/>
        <SolidColorBrush x:Key="NodeBorder" Color="#505050"/>
        <SolidColorBrush x:Key="EdgeStroke" Color="#CFCFCF"/>

        <SolidColorBrush x:Key="Accent" Color="#F2B705"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFC83D"/>
        <SolidColorBrush x:Key="AccentFocus" Color="#FFD86A"/>
        <SolidColorBrush x:Key="AccentSelectBg" Color="#3A2D00"/>
        <SolidColorBrush x:Key="ControlBg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="ControlBg2" Color="#222222"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#262626"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>

        <Style x:Key="DarkComboBoxBase" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBg2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">

                            <Border x:Name="Outer"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Glow"
                                                      Color="#F2B705"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Inner"
                                    Margin="1"
                                    Background="{DynamicResource ControlBg}"
                                    BorderBrush="#2B2B2B"
                                    BorderThickness="1">
                                <Grid>
                                    <Border Height="1"
                                            VerticalAlignment="Top"
                                            Background="#3F3F3F"
                                            Opacity="0.85"/>
                                </Grid>
                            </Border>

                            <Border x:Name="SelectionBg"
                                    Margin="2"
                                    Background="#1A1A1A"
                                    Opacity="1"
                                    IsHitTestVisible="False"/>

                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ControlBg}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        Margin="0,6,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Inner" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="SelectionBg" Property="Opacity" Value="0.55"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FFC83D"/>
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#4A4A4A"/>
                                <Setter TargetName="Inner" Property="Background" Value="#202020"/>
                                <Setter TargetName="SelectionBg" Property="Background" Value="#202020"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.22" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="10" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FFD86A"/>
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#5A5A5A"/>
                                <Setter TargetName="Inner" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="SelectionBg" Property="Background" Value="#1E1E1E"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.32" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="14" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FFD86A"/>
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#5A5A5A"/>
                                <Setter TargetName="Inner" Property="Background" Value="#1C1C1C"/>
                                <Setter TargetName="SelectionBg" Property="Background" Value="#1C1C1C"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.42" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="16" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="LeftMark"
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2720"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B5A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="LeftMark" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                                <Setter TargetName="LeftMark" Property="Background" Value="{DynamicResource AccentHover}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#4A3800"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MachineTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <DataTemplate x:Key="UnitTemplate">
            <TextBlock TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="PerSecond">
                                <Setter Property="Text" Value="/сек"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="PerMinute">
                                <Setter Property="Text" Value="/мин"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="PerHour">
                                <Setter Property="Text" Value="/час"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="MachineComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxBase}">
            <Setter Property="ItemTemplate" Value="{StaticResource MachineTemplate}"/>
        </Style>

        <Style x:Key="UnitComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxBase}">
            <Setter Property="ItemTemplate" Value="{StaticResource UnitTemplate}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#232323"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E2E2E"/>
            <Setter Property="VerticalGridLinesBrush" Value="#2E2E2E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#272727"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#343434"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="#2C2C2C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="Сборщик:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="230"
                      Style="{StaticResource MachineComboStyle}"
                      ItemsSource="{Binding AssemblerMachines}"
                      SelectedItem="{Binding SelectedAssemblerMachine}"
                      DisplayMemberPath="Name"
                      Margin="0,0,12,0"/>

            <TextBlock Text="Печь:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="230"
                      Style="{StaticResource MachineComboStyle}"
                      ItemsSource="{Binding FurnaceMachines}"
                      SelectedItem="{Binding SelectedFurnaceMachine}"
                      DisplayMemberPath="Name"
                      Margin="0,0,12,0"/>

            <TextBlock Text="Бур:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="260"
                      Style="{StaticResource MachineComboStyle}"
                      ItemsSource="{Binding DrillMachines}"
                      SelectedItem="{Binding SelectedDrillMachine}"
                      DisplayMemberPath="Name"
                      Margin="0,0,12,0"/>

            <TextBlock Text="Единицы:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="170"
                      Style="{StaticResource UnitComboStyle}"
                      ItemsSource="{Binding Units}"
                      SelectedItem="{Binding SelectedUnit}"
                      Margin="0,0,12,0"/>

            <CheckBox Content="Схлопнуть граф"
                      IsChecked="{Binding MergeGraphByItem}"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>

            <Button Content="Рассчитать"
                    Command="{Binding CalculateCommand}"
                    Margin="0,0,12,0"/>

            <Button Content="Сохранить"
                    Command="{Binding SavePresetCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"/>

            <Button Content="Загрузить"
                    Command="{Binding LoadPresetCommand}"
                    Padding="12,6"
                    Margin="0,0,12,0"/>

            <Button Content="x2"
                    Command="{Binding ScaleTargetsCommand}"
                    CommandParameter="2"
                    Padding="10,6"
                    Margin="0,0,6,0"/>

            <Button Content="/2"
                    Command="{Binding ScaleTargetsCommand}"
                    CommandParameter="0.5"
                    Padding="10,6"
                    Margin="0,0,10,0"/>

            <Button Content="+10%"
                    Command="{Binding ScaleTargetsCommand}"
                    CommandParameter="1.1"
                    Padding="10,6"
                    Margin="0,0,6,0"/>

            <Button Content="–10%"
                    Command="{Binding ScaleTargetsCommand}"
                    CommandParameter="0.9"
                    Padding="10,6"
                    Margin="0,0,0,0"/>

        </WrapPanel>

        <GroupBox Grid.Row="1" Header="Цели" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="+ Цель"
                            Command="{Binding AddTargetCommand}"
                            Margin="0,0,8,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          Height="160"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Предмет" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Item.Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Items, ElementName=RootWindow}"
                                              SelectedItem="{Binding Item, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource MachineComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Количество"
                                            Width="160"
                                            Binding="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"/>

                        <DataGridTextColumn Header="Ед."
                                            Width="80"
                                            IsReadOnly="True"
                                            Binding="{Binding DataContext.UnitLabel, ElementName=RootWindow}"/>

                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить"
                    Command="{Binding DataContext.RemoveTargetCommand, ElementName=RootWindow}"
                    CommandParameter="{Binding}"
                    Padding="12,6"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="0,0,12,0">
                <TabItem Header="Дерево">
                    <GroupBox Header="Дерево зависимостей" Margin="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView ItemsSource="{Binding Tree.Children}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Border ToolTip="{Binding ToolTip}" Padding="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedFg}" Margin="0,3,0,8"/>
                                            </StackPanel>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </GroupBox>
                </TabItem>

                <TabItem Header="Граф">
                    <GroupBox Header="Граф зависимостей" Margin="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Graph_PreviewMouseWheel"
                                      PreviewMouseLeftButtonDown="Graph_MouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="Graph_MouseLeftButtonUp"
                                      PreviewMouseMove="Graph_MouseMove">

                            <Grid Background="{DynamicResource GraphBg}">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                        <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <Border Width="{Binding GraphWidth}" Height="{Binding GraphHeight}" Background="{DynamicResource GraphBg}"/>

                                <ItemsControl ItemsSource="{Binding GraphEdges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas IsHitTestVisible="True">
                                                <Path Data="{Binding Curve}"
                                                      Stroke="{DynamicResource EdgeStroke}"
                                                      StrokeThickness="1.8"
                                                      Opacity="0.9"
                                                      ToolTip="{Binding ToolTip}"/>
                                                <Path Data="{Binding ArrowHead}"
                                                      Fill="{DynamicResource EdgeStroke}"
                                                      ToolTip="{Binding ToolTip}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding GraphNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}"
                                                    Padding="10"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource NodeBg}"
                                                    BorderBrush="{DynamicResource NodeBorder}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding ToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedFg}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <TabControl Grid.Column="1" Margin="0,0,12,0">
                <TabItem Header="Добыча">
                    <GroupBox Header="Базовые ресурсы" Margin="8">
                        <DataGrid ItemsSource="{Binding RawRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ресурс" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Value, StringFormat={}{0:F2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </TabItem>

                <TabItem Header="Топливо">
                    <GroupBox Header="Расход топлива" Margin="8">
                        <DataGrid ItemsSource="{Binding FuelRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Топливо" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Value, StringFormat={}{0:F2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </TabItem>

                <TabItem Header="Электричество">
                    <GroupBox Header="Электропотребление" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Потребление" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="#202020"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Всего:" Foreground="{DynamicResource MutedFg}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding TotalPowerKw, StringFormat={}{0:F1} kW}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <GroupBox Header="Машины" Grid.Column="2">
                <DataGrid ItemsSource="{Binding MachineRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Value, StringFormat={}{0:F2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

        </Grid>
    </Grid>
</Window>
